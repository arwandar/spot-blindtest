# Spotify API Credentials
# Créez une application sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# URI de redirection Spotify OAuth (doit correspondre à celle enregistrée sur le dashboard Spotify)
SPOTIFY_REDIRECT_URI=http://localhost:5174/callback

# (Optionnel) Configuration de développement Vite
# ALLOWED_HOSTS=localhost,blindspot.example.com
# HMR_CLIENT_PORT=443
